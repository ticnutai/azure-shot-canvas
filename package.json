{
  "name": "hebrew-screen-studio",
  "version": "0.32.4",
  "description": "אולפן צילום והקלטת מסך מקומי ל-Windows",
  "main": "src/main.cjs",
  "author": "Screen Studio",
  "license": "MIT",
  "scripts": {
    "editor:build": "node scripts/build-editor-bundle.cjs",
    "predist": "npm run editor:build",
    "start": "npm run electron:dev",
    "dev": "node scripts/dev-server.cjs",
    "dev:stop": "node scripts/stop-dev-server.cjs",
    "localhost": "npm run dev",
    "localhost:open": "node scripts/open-localhost.cjs",
    "electron": "electron .",
    "electron:start": "npm run electron",
    "electron:dev": "node scripts/start-electron-dev.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "test:qa": "node scripts/run-qa.cjs",
    "test:qa-dashboard": "node scripts/verify-qa-dashboard.cjs",
    "test:qa:open": "node scripts/open-latest-report.cjs",
    "dist": "electron-builder --win nsis",
    "build": "npm run electron:dist",
    "electron:pack": "electron-builder --win dir",
    "electron:dist": "npm run dist"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.9",
    "fabric": "^7.4.0",
    "onnxruntime-web": "^1.31.1",
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "il.screenstudio.capture",
    "productName": "אולפן צילום מסך",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableCookieEncryption": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "artifactName": "Aurum-Screen-Studio-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "ticnutai",
        "repo": "aurum-screen-studio-releases",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/bmp-js/**",
      "node_modules/idb-keyval/**",
      "node_modules/is-url/**",
      "node_modules/node-fetch/**",
      "node_modules/whatwg-url/**",
      "node_modules/tr46/**",
      "node_modules/punycode/**",
      "node_modules/webidl-conversions/**",
      "node_modules/opencollective-postinstall/**",
      "node_modules/regenerator-runtime/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/wasm-feature-detect/**",
      "node_modules/zlibjs/**"
    ]
  },
  "dependencies": {
    "docx": "^9.9.0",
    "electron-updater": "^6.8.9",
    "jsqr": "^1.4.0",
    "tesseract.js": "^6.0.1"
  },
  "overrides": {
    "wasm-feature-detect": "1.9.0"
  }
}
